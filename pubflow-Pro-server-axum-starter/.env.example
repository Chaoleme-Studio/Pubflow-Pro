# 数据库配置（必需）
DATABASE_URL=postgresql://postgres:password@localhost:5432/{{project-name | snake_case}}_db

# 敏感信息配置
# JWT 密钥（必需，至少 32 个字符）
JWT_SECRET=your-secret-jwt-key-at-least-32-characters

# PubFlow 密钥配置
# Selector AES 派生主密钥（至少 32 字符）
SELECTOR_SECRET=your-selector-secret-at-least-32-chars
# Selector PFSP v1 X25519 服务端私钥（32 字节 hex；生产环境必须显式配置）
# 可由后端工具或临时脚本生成，开发环境未配置时会从 SELECTOR_SECRET 派生稳定私钥
# SELECTOR_PROTOCOL_PRIVATE_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Selector PFSP v1 请求时间窗口和 nonce 去重 TTL
SELECTOR_REPLAY_WINDOW_SECONDS=120
SELECTOR_NONCE_TTL_SECONDS=600
# 机器码哈希盐（至少 16 字符）
MACHINE_SALT=your-machine-salt-at-least-16-chars
# 管理端 JWT Token 密钥（至少 32 字符）
ADMIN_TOKEN=your-admin-token-at-least-32-characters
# 管理后台登录账号
ADMIN_USERNAME=admin
# 管理后台登录密码（首次启动时会自动生成哈希，建议使用 ADMIN_PASSWORD_HASH）
ADMIN_PASSWORD=your-admin-password
# 管理后台登录密码哈希（Argon2 格式，优先使用，更安全）
# 可以使用 `htpasswd -bnBC 10 "" your-password | tr -d ':\n'` 生成
# ADMIN_PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$...

# Redis 配置（可选，不配置则跳过 Redis 初始化）
# REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://:password@localhost:6379/0
# REDIS_URL=redis://:password@redis-cluster.example.com:6380/1

# Tracing 环境变量
RUST_LOG=info,axum=debug,tower_http=debug

# 应用配置覆盖（使用 APP_ 前缀）
# 注意：数组类型配置（如 CORS 的 allow_origins）建议在 config.toml 中设置，
#       环境变量主要用于覆盖简单的标量值。

# 服务器配置
# APP_SERVER_HOST=0.0.0.0
# APP_SERVER_PORT=3001
# APP_SERVER_TIMEOUT=60

# 数据库配置
# APP_DATABASE_MAX_CONNECTIONS=20
# APP_DATABASE_POOL_TIMEOUT=60

# 日志配置
# APP_LOGGING_LEVEL=debug
# APP_LOGGING_CONSOLE_FORMAT=pretty
# APP_LOGGING_CONSOLE=true
# APP_LOGGING_FILE=true
# APP_LOGGING_FILE_DIR=/var/log/myapp
# APP_LOGGING_FILE_PREFIX=app
# APP_LOGGING_ROTATION=daily
# APP_LOGGING_MAX_FILES=30
# APP_LOGGING_CLEANUP_ENABLED=true
# APP_LOGGING_CLEANUP_INTERVAL=168  # 支持格式: 168、"7x24"、"7d"、"168h"

# CORS 配置（建议在 config.toml 中配置数组类型，这里仅作示例）
# APP_CORS_ALLOW_CREDENTIALS=true
# APP_CORS_MAX_AGE=7200
