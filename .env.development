# ==============================================================================
# PubFlow Pro - 本地开发环境
# ==============================================================================
# 只维护根目录这份文件；子项目内部不再保留 .env。
#
# 可以直接进入子项目启动：
#   插件端：cd pubflow-Pro && pnpm dev
#   网页端：cd pubflow-Pro-Web && pnpm dev
#   服务端：cd pubflow-Pro-server-axum-starter && cargo run -p app
#
# 端口关系只看两类：
#   PUBLIC_API_BASE_URL：插件端 / 网页端访问后端的地址
#   APP_SERVER_HOST + APP_SERVER_PORT：服务端真实监听地址
# ==============================================================================

# ==============================================================================
# 01. 插件端（Chrome 扩展）- 最高频修改
# ==============================================================================
# 插件内置的授权 API 地址。
# 本地默认后端：http://127.0.0.1:5189
PUBLIC_API_BASE_URL=http://127.0.0.1:5189

# 插件底部版本号 / 官网入口跳转地址。
PUBFLOW_OFFICIAL_SITE_URL=http://127.0.0.1:5188

# Chrome 开发调试端口。只有 pnpm dev:9222 或手动调试现有浏览器时才需要关注。
PUBFLOW_CHROMIUM_PORT=9222

# Chrome 开发 Profile 路径，用来保留登录态、扩展存储、授权过的工作区句柄。
PUBFLOW_CHROMIUM_PROFILE="$HOME/Downloads/PubFlow/chrome-profile-9222"

# 插件设置页里预填的本地工作区路径；第一次仍要在浏览器里点一次授权。
PUBFLOW_DEV_WORKSPACE_PATH="$HOME/Downloads/PubFlow/workspace"

# ==============================================================================
# 02. 网页端（官网 / 管理后台 / 购买页）- 高频修改
# ==============================================================================
# 网页端请求后端也使用 PUBLIC_API_BASE_URL。
# 不需要重复写 VITE_PUBFLOW_API_BASE_URL，vite.config.ts 会自动注入。

# 网页端 Vite 开发服务端口。
# 浏览器打开：http://127.0.0.1:5188
WEB_DEV_SERVER_PORT=5188

# ==============================================================================
# 03. 服务端（Rust / Axum 后端）- 高频修改
# ==============================================================================
# 服务端真实监听地址。0.0.0.0 表示允许局域网访问；127.0.0.1 表示只允许本机访问。
APP_SERVER_HOST=0.0.0.0

# 服务端真实监听端口。这就是后端启动端口。
APP_SERVER_PORT=5189

# PostgreSQL 连接串：postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pubflow

# 管理后台登录账号和密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# 设置后优先于 ADMIN_PASSWORD；适合生产环境隐藏明文密码。
# ADMIN_PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$...

# 开发环境是否自动写入演示商品、下载项和测试数据；生产必须关闭。
APP_SEED_DEMO=true

# ==============================================================================
# 04. 服务端（运行参数 / 日志 / 下载）- 中频修改
# ==============================================================================
# HTTP 请求超时时间，单位：秒。
APP_SERVER_TIMEOUT=60

# Rust 日志级别；排查接口问题时可临时改成 debug。
RUST_LOG=info,axum=debug,tower_http=debug

# Redis 可选。不配置则跳过 Redis 初始化，服务端仍可运行。
# REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://:password@localhost:6379/0

# 扩展 ZIP / CRX 下载包所在目录；本地构建脚本默认会使用项目根目录 downloads。
# DOWNLOADS_FS_PATH=./downloads

# ==============================================================================
# 05. 服务端（购买 / 支付）- 中频修改
# ==============================================================================
# 代售平台备用链接。官方支付宝未启用或创建二维码失败时，前端展示这个入口。
PAYMENT_RESELLER_URL=https://www.aidoumi.com//links/6C406BEA

# 是否启用官方支付宝扫码支付。false 时只使用上面的代售链接。
ALIPAY_ENABLED=false

# 支付宝应用 APPID；ALIPAY_ENABLED=true 时必填。
ALIPAY_APP_ID=

# 支付宝网关；正式环境一般不用改。
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 支付宝异步通知地址；生产启用支付宝时应填写公网可访问的回调 URL。
ALIPAY_NOTIFY_URL=

# 支付宝证书序列号。证书文件无法自动推导时，在这里手动填写。
ALIPAY_APP_CERT_SN=
ALIPAY_ROOT_CERT_SN=

# 支付订单标题前缀和二维码有效期。
ALIPAY_SUBJECT_PREFIX=PubFlow Pro
ALIPAY_TIMEOUT_EXPRESS=30m

# ==============================================================================
# 06. 服务端（安全密钥）- 低频修改
# ==============================================================================
# JWT 签名密钥，至少 32 字符；生产必须换成强随机值。
JWT_SECRET=dev-jwt-secret-at-least-32-characters

# License Ed25519 签名种子，32 字节 hex，也就是 64 个 hex 字符。
LICENSE_SIGNING_SEED_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Selector 数据加密主密钥，至少 32 字符。
SELECTOR_SECRET=dev-selector-secret-at-least-32-chars

# Selector PFSP v1 X25519 服务端私钥，32 字节 hex。
SELECTOR_PROTOCOL_PRIVATE_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Selector 协议公钥版本号；轮换协议密钥时递增。
SELECTOR_PROTOCOL_KEY_VERSION=1

# Selector 协议元数据签名私钥，P-256 scalar，32 字节 hex。
SELECTOR_PROTOCOL_SIGNING_PRIVATE_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Selector 请求防重放窗口和 nonce 去重 TTL，单位：秒。
SELECTOR_REPLAY_WINDOW_SECONDS=120
SELECTOR_NONCE_TTL_SECONDS=600

# 机器码哈希盐；生产必须换成强随机值。
MACHINE_SALT=dev-machine-salt-16

# 管理端 Bearer Token，至少 32 字符。
ADMIN_TOKEN=dev-admin-token-at-least-32-characters

# ==============================================================================
# 07. 插件端（生产保护构建）- 最低频修改
# ==============================================================================
# 开发环境默认不混淆；生产发布用 .env.production。
# OBFUSCATE=1
# OBFUSCATE_LICENSE_UI=1

# 授权协议服务端 X25519 公钥，32 字节 hex。开发可留空，由插件运行时查询。
PUBFLOW_PROTOCOL_PUBLIC_KEY=

# 协议公钥元数据签名信任根，P-256 SPKI，base64url，无 padding。
PUBFLOW_PROTOCOL_TRUST_ROOT_P256_SPKI=
