# ==============================================================================
# PubFlow Pro - 本地开发环境
# ==============================================================================
# 只维护根目录这份文件；子项目内部不再保留 .env。
#
# 可以直接进入子项目启动：
#   插件端：cd pubflow-Pro && pnpm dev
#   网页端：cd pubflow-Pro-Web && pnpm dev
#   服务端：cd pubflow-Pro-server-axum-starter && cargo run -p app
#   Native：cd pubflow-Pro-Native && cargo run
#
# 端口关系只看三类：
#   PUBLIC_API_BASE_URL：插件端 / 网页端访问后端的地址
#   APP_SERVER_HOST + APP_SERVER_PORT：服务端真实监听地址
#   PUBFLOW_AGENT_HOST + PUBFLOW_AGENT_PORT：Native 局域网页面和插件 WebSocket 监听地址
# ==============================================================================

# ==============================================================================
# 00. 纯本地模式（开发 / 自用离线构建）
# ==============================================================================
# 1 = 跳过授权激活、lease 联网验证、发布 permit 签发、远程 selector 刷新和更新检查。
# 插件固定以 plus 身份运行（publish / batch / selector-updates / native-publish），
# 不启动依赖服务端的 remote-publish 云端通道。
# 只在 .env.development 开启；生产 .env.production 不要设置。
PUBFLOW_LOCAL_MODE=1

# ==============================================================================
# 01. 插件端（Chrome 扩展）- 最高频修改
# ==============================================================================
# 插件内置的授权 API 地址。
# 本地默认后端：http://127.0.0.1:5189
PUBLIC_API_BASE_URL=http://127.0.0.1:5189

# 插件底部版本号 / 官网入口跳转地址。
PUBFLOW_OFFICIAL_SITE_URL=http://127.0.0.1:5188

# Chrome 开发调试端口。只有 pnpm dev:9222 或手动调试现有浏览器时才需要关注。
PUBFLOW_CHROMIUM_PORT=9222

# Chrome 开发 Profile 路径，用来保留登录态、扩展存储、授权过的工作区句柄。
PUBFLOW_CHROMIUM_PROFILE="$HOME/Downloads/PubFlow/chrome-profile-9222"

# 插件逐个填写话题时，输入 #话题 后和按 Enter 后的等待时间（毫秒）。
PUBFLOW_TOPIC_INTERVAL_MS=800

# ==============================================================================
# 02. Native（本地 Agent / 脚本通道）- 高频修改
# ==============================================================================
# Native 监听端口；同时注入插件的本地 WebSocket 默认地址。
PUBFLOW_AGENT_PORT=5190

# 0.0.0.0 允许同一局域网的手机访问本地发布页；Native 会再次校验来源 IP，拒绝公网地址。
PUBFLOW_AGENT_HOST=0.0.0.0

# 仅供网页端 Vite 开发代理 /v1/local 使用；发布版网页由 Native 二进制同源托管。
PUBFLOW_AGENT_HTTP_URL=http://127.0.0.1:5190

# 本地发布页访问密码；只保护局域网页面，Plus / Pro 套餐权限仍由插件和服务端校验。
PUBFLOW_LOCAL_PASSWORD=123456

# 可选：仅在需要固定工作区时启用。默认首次启动弹出目录选择器，之后读取 Native config.json。
# PUBFLOW_WORKSPACE="$HOME/Downloads/PubFlow/workspace"

# Native 自身的 Token、SQLite 和 config.json 存放目录。
PUBFLOW_AGENT_DATA_DIR="$HOME/.pubflow-pro-native"

# HTTP Token 默认首次启动自动生成，不要把真实 Token 写入受版本控制的文件。
# PUBFLOW_AGENT_API_TOKEN=

# 生产 Native 可选限制插件 ID，并为本地 WebSocket 增加 Token。
# PUBFLOW_ALLOWED_EXTENSION_IDS=
# PUBFLOW_EXTENSION_TOKEN=

# ==============================================================================
# 03. 网页端（官网 / 管理后台 / 购买页）- 高频修改
# ==============================================================================
# 网页端请求后端也使用 PUBLIC_API_BASE_URL。
# 不需要重复写 VITE_PUBFLOW_API_BASE_URL，vite.config.ts 会自动注入。

# 网页端 Vite 开发服务端口。
# 浏览器打开：http://127.0.0.1:5188
WEB_DEV_SERVER_PORT=5188

# ==============================================================================
# 04. 服务端（Rust / Axum 后端）- 高频修改
# ==============================================================================
# 服务端真实监听地址。0.0.0.0 表示允许局域网访问；127.0.0.1 表示只允许本机访问。
APP_SERVER_HOST=0.0.0.0

# 服务端真实监听端口。这就是后端启动端口。
APP_SERVER_PORT=5189

# PostgreSQL 连接串：postgresql://用户名:密码@主机:端口/数据库名
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pubflow
DATABASE_URL=postgresql://postgres:1panel_postgresql@www.pubflow.chaoleme.cn:25432/pubflow


# 管理后台登录账号和密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# 设置后优先于 ADMIN_PASSWORD；适合生产环境隐藏明文密码。
# ADMIN_PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$...

# 开发环境是否自动写入演示商品、下载项和测试数据；生产必须关闭。
APP_SEED_DEMO=true

# 远程发布每个 License 的默认每日上限；单个 License 仍可在管理端独立覆盖。
REMOTE_PUBLISH_DAILY_JOB_LIMIT=3
REMOTE_PUBLISH_DAILY_BYTE_LIMIT=104857600

# 整个服务进程的远程素材上传+下载共享上限：196608 B/s = 192 KiB/s。
# 这是全应用总限速，不是每用户、每连接各一份。
REMOTE_PUBLISH_AGGREGATE_TRANSFER_BYTES_PER_SECOND=196608
REMOTE_PUBLISH_MAX_CONCURRENT_TRANSFERS=4

# ---- HTTP API 全局限流（防滥用兜底，按“真实客户端 IP”计数）----
# 只约束普通 HTTP 接口调用，与下面三者完全无关：
#   · WebSocket 长连接数量（心跳、任务同步走 WS，不计入）
#   · 素材上传/下载带宽（由上面的 REMOTE_PUBLISH_AGGREGATE_* 单独限速）
#   · 单用户正常点击（突发 100 足够一次页面加载 + 多个并发接口）
#
# REQUESTS_PER_SECOND=20：每个真实客户端 IP 稳态最多 20 次/秒；这是上限，不会主动发请求。
# BURST=100：桶最多攒 100 个令牌，避免公司/校园网共享出口 IP 时误伤正常用户。
#
# 何时需要调高：
#   · 多用户共用同一出口 IP（公司/校园网 NAT）会共享这 20 次/秒；核心授权接口另有设备/License 业务限流。
#   · 某个高频轮询接口被误伤 → 优先把该路径摘出全局限流单独配，而不是一味调高全局值。
# 何时不用动：该参数与 WebSocket 连接数、心跳和素材带宽无关。
APP_HTTP_RATE_LIMIT_REQUESTS_PER_SECOND=20
APP_HTTP_RATE_LIMIT_BURST=100

# ==============================================================================
# 05. 服务端（运行参数 / 远程任务生命周期 / 日志 / 下载）- 中频修改
# ==============================================================================
# HTTP 请求超时时间，单位：秒。
APP_SERVER_TIMEOUT=60

# Rust 日志级别；排查接口问题时可临时改成 debug。
RUST_LOG=info,axum=debug,tower_http=debug

# Redis 可选。不配置则跳过 Redis 初始化，服务端仍可运行。
# REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://:password@localhost:6379/0

# 扩展 ZIP / CRX 下载包所在目录；本地构建脚本默认会使用项目根目录 downloads。
# DOWNLOADS_FS_PATH=./downloads

# 远程素材本地落盘目录。
REMOTE_PUBLISH_STORAGE_PATH=./data/remote-publish

# 网页端短会话 15 分钟、长会话 30 天，素材下载票据 10 分钟。
REMOTE_PUBLISH_ACCESS_TTL_SECONDS=900
REMOTE_PUBLISH_REFRESH_TTL_SECONDS=2592000
REMOTE_PUBLISH_ASSET_TICKET_TTL_SECONDS=600

# 未完成上传的任务保留 72 小时；终态任务与素材保留 30 天。
REMOTE_PUBLISH_UNCLAIMED_RETENTION_HOURS=72
REMOTE_PUBLISH_JOB_RETENTION_DAYS=30

# 本地 HTTP 开发必须关闭；生产 HTTPS 必须开启。
REMOTE_PUBLISH_SECURE_COOKIES=false

# ==============================================================================
# 06. 服务端（购买 / 支付）- 中频修改
# ==============================================================================
# 代售平台备用链接。官方支付宝未启用或创建二维码失败时，前端展示这个入口。
PAYMENT_RESELLER_URL=https://www.aidoumi.com//links/6C406BEA

# 是否启用官方支付宝扫码支付。false 时只使用上面的代售链接。
ALIPAY_ENABLED=true

# 支付宝沙箱应用 APPID；ALIPAY_ENABLED=true 时必填。
ALIPAY_APP_ID=9021000165680270

# 支付宝沙箱网关。生产环境使用 https://openapi.alipay.com/gateway.do。
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# 支付宝异步通知地址；启用扫码支付时填写公网可访问的回调 URL。
ALIPAY_NOTIFY_URL="www.chaoleme.cn"

# 当前使用普通 RSA 公钥模式，只需要下面两把密钥，不需要证书 SN。
# 每把密钥支持“直接文本”或“文件路径”二选一；如果同时填写，直接文本优先。
# 文件可填写绝对路径，也可填写相对于服务端启动目录的相对路径。

# ① 应用私钥：本服务创建支付宝订单时用于 RSA2 签名，必须保密，不能上传给支付宝。 （当前为支付宝沙箱数据）
# 文本形式支持带或不带 -----BEGIN PRIVATE KEY----- 标记。
ALIPAY_APP_PRIVATE_KEY=""
ALIPAY_APP_PRIVATE_KEY_FILE=

# ② 支付宝公钥：本服务用于验证支付宝响应和异步通知签名，可以公开。
# 注意：这是支付宝开放平台提供的“支付宝公钥”，不是本地的“应用公钥RSA2048.txt”。
# 文本形式支持带或不带 -----BEGIN PUBLIC KEY----- 标记。
ALIPAY_PUBLIC_KEY=""
ALIPAY_PUBLIC_KEY_FILE=

# 支付宝另有“公钥证书模式”，该模式才需要应用公钥证书、支付宝根证书和证书 SN；
# 本项目当前配置采用普通 RSA 公钥模式，所以不填写 ALIPAY_APP_CERT_SN / ALIPAY_ROOT_CERT_SN。

# 支付订单标题前缀和二维码有效期。
ALIPAY_SUBJECT_PREFIX="PubFlow Pro"
ALIPAY_TIMEOUT_EXPRESS=30m

# ==============================================================================
# 07. 服务端（安全密钥）- 低频修改
# ==============================================================================
# JWT 签名密钥，至少 32 字符；生产必须换成强随机值。
JWT_SECRET=dev-jwt-secret-at-least-32-characters

# License Ed25519 签名种子，32 字节 hex，也就是 64 个 hex 字符。
LICENSE_SIGNING_SEED_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Selector 数据加密主密钥，至少 32 字符。
SELECTOR_SECRET=dev-selector-secret-at-least-32-chars

# Selector PFSP v1 X25519 服务端私钥，32 字节 hex。
SELECTOR_PROTOCOL_PRIVATE_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Selector 协议公钥版本号；轮换协议密钥时递增。
SELECTOR_PROTOCOL_KEY_VERSION=1

# Selector 协议元数据签名私钥，P-256 scalar，32 字节 hex。
SELECTOR_PROTOCOL_SIGNING_PRIVATE_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Selector 请求防重放窗口和 nonce 去重 TTL，单位：秒。
SELECTOR_REPLAY_WINDOW_SECONDS=120
SELECTOR_NONCE_TTL_SECONDS=600

# 机器码哈希盐；生产必须换成强随机值。
MACHINE_SALT=dev-machine-salt-16

# 管理端 Bearer Token，至少 32 字符。
ADMIN_TOKEN=dev-admin-token-at-least-32-characters

# ==============================================================================
# 08. 插件端（生产保护构建）- 最低频修改
# ==============================================================================
# 开发环境默认不混淆；生产发布用 .env.production。
# OBFUSCATE=1
# OBFUSCATE_LICENSE_UI=1

# 授权协议服务端 X25519 公钥，32 字节 hex。开发可留空，由插件运行时查询。
PUBFLOW_PROTOCOL_PUBLIC_KEY=e91e79b4de059792ab2e0b883450a04c23da3d810d72784f7ad02e6502222952

# 协议公钥元数据签名信任根，P-256 SPKI，base64url，无 padding。
PUBFLOW_PROTOCOL_TRUST_ROOT_P256_SPKI=MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE2M0S6lxn8vigDBEkiT7c-mdUxNbO3mvhO98ilcgQqX-lqJ0tKjYMDKmk1sfJ7Uso0-GZ1mJ_LmltaJwxClsPSA
